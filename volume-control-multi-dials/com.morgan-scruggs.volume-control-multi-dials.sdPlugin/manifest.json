{
	"Name": "Volume Control Multi Dials",
	"Version": "0.1.0.0",
	"Author": "Morgan Scruggs",
	"Actions": [
		{
			"Name": "Multi Volume Dial",
			"UUID": "com.morgan-scruggs.volume-control-multi-dials.volume",
			"Icon": "imgs/actions/volume/icon",
			"Tooltip": "Control the volume of an application.",
			"PropertyInspectorPath": "ui/volume-control.html",
			"Controllers": [
				"Encoder"
			],

			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust Volume",
					"Push": "Mute / Unmute",
					"Touch": "Mute / Unmute"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/volume/key"
				}
			]
		}
	],
	"Category": "Volume Control Multi Dials",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Dials to control multiple applications at once",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.morgan-scruggs.volume-control-multi-dials"
}